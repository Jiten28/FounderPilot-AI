# FounderPilot AI — environment variables
# Copy this file to .env in the SAME location it's needed:
#   backend/.env   → backend section below
#   frontend/.env  → frontend section below
# (Two .env files are normal — one per app — only this example is unified.)

# ============ BACKEND (backend/.env) ============

# Your xAI (Grok) API key. Get it from https://console.x.ai
# Without it, /analyze and /chat automatically fall back to deterministic
# responses (ai_degraded: true) instead of failing — safe for local dev.
XAI_API_KEY=

# Confirm the current fast/cheap model slug in the xAI console — xAI retires
# and redirects model IDs frequently, so don't assume this default is current.
GROK_MODEL=grok-4-fast

# Timeout (seconds) for the Grok API call before falling back.
GROK_TIMEOUT_SECONDS=8.0

# Must match the deployed frontend URL exactly, or CORS blocks requests.
FRONTEND_ORIGIN=http://localhost:5173

# SQLite by default — zero setup, fine for a small deployed demo.
DATABASE_URL=sqlite:///./founderpilot.db

# ============ FRONTEND (frontend/.env) ============

# Base URL of the backend API. Local dev default shown; set to your Render
# backend URL (e.g. https://founderpilot-ai-backend.onrender.com) once deployed.
VITE_API_BASE_URL=http://localhost:8000
